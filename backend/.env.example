# Environment
NODE_ENV=development
PORT=4000

# Allowed origin for CORS (Angular dev server)
CLIENT_ORIGIN=http://localhost:4200

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clockify_dupe
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
